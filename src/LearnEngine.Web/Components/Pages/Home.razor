@page "/"
@using LearnEngine.Web.Feed
@implements IDisposable
@inject EngineFeed Feed

<PageTitle>LearnEngine</PageTitle>

<h1>LearnEngine is running</h1>
<p>Connect an AI to <code>http://localhost:5080/mcp</code>, such as with
<code>claude mcp add --transport http learnengine http://localhost:5080/mcp</code>.</p>
<p>@Feed.Recent.Length turns reported since the app started.</p>

@code {
    protected override void OnInitialized() => Feed.Shown += OnShown;

    private void OnShown(TurnShown shown) => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Stops listening to the feed when the page closes.
    /// </summary>
    public void Dispose() => Feed.Shown -= OnShown;
}
